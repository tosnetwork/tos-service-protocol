# Generated by scripts/generate-escrow-v2-vectors.sh: @TOS@ is replaced with
# the TOS checkout whose escrow contract and sandbox produce the vectors.
[package]
name = "escrow-v2-vectors"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
anyhow = "1.0"
base64 = "0.22"
chain_block = { path = "@TOS@/tosctl/src/block" }
ed25519-dalek = "2"
hex = "0.4.3"
serde_json = "1"
sha2 = "0.10"
tos_sandbox = { path = "@TOS@/tosctl/src/sandbox" }

[workspace]
